  border: 1px solid {pal["outline_variant"]};
  box-shadow: 0 12px 40px rgba(0, 0, 0, 0.6);
  padding: 18px 16px;
}}

.control-center-list {{
  background: transparent;
}}

.control-center .control-center-list-placeholder {{
  opacity: 0.6;
  color: {pal["on_surface_variant"]};
  font-size: 14px;
  padding: 24px 0;
}}

/* Clean Single-Card Notifications (Eliminating nested box artifacts) */
.notification-group {{
  background: transparent;
  border: none;
  box-shadow: none;
}}

.notification-row {{
  background: transparent;
  outline: none;
  margin: 4px 0;
  border: none;
}}

