# Material You Dynamic Theme for btop
# Auto-generated by change-wallpaper using materialyoucolor

# Main background, empty for terminal default, need to be empty if you want transparent background
theme[main_bg]="#150D00"

# Main text color
theme[main_fg]="#FFE2AF"

# Title color for boxes
theme[title]="#FFE2AE"

# Highlight color for keyboard shortcuts
theme[hi_fg]="#BAC3FF"

# Background color of selected item in processes box
theme[selected_bg]="#FED17B"

# Foreground color of selected item in processes box
theme[selected_fg]="#624600"

# Color of inactive/disabled text
theme[inactive_fg]="#897246"

# Misc colors for processes box including mini cpu graphs, details memory graph and details status text
theme[proc_misc]="#C5C4DD"

# Cpu box outline color
theme[cpu_box]="#58451E"

# Memory/disks box outline color
theme[mem_box]="#58451E"

# Net up/down box outline color
theme[net_box]="#58451E"

# Processes box outline color
theme[proc_box]="#58451E"

# Box divider line and small boxes line color
theme[div_line]="#58451E"

# Temperature graph colors
theme[temp_start]="#44DADC"
theme[temp_mid]="#DBC582"
theme[temp_end]="#FE7453"

# CPU graph colors
theme[cpu_start]="#FFE2AE"
theme[cpu_mid]="#BAC3FF"
theme[cpu_end]="#FE7453"

# Mem/Disk free meter
theme[free_start]="#A0D756"
theme[free_mid]="#44DADC"
theme[free_end]="#FFE2AE"

# Mem/Disk cached meter
theme[cached_start]="#C5C4DD"
theme[cached_mid]="#BAC3FF"
theme[cached_end]="#FFADE3"

# Mem/Disk available meter
theme[available_start]="#44DADC"
theme[available_mid]="#FFE2AE"
theme[available_end]="#DBC582"

# Mem/Disk used meter
theme[used_start]="#FFE2AE"
theme[used_mid]="#DBC582"
theme[used_end]="#FE7453"

# Download graph colors
theme[download_start]="#44DADC"
theme[download_mid]="#FFE2AE"
theme[download_end]="#BAC3FF"

# Upload graph colors
theme[upload_start]="#FFADE3"
theme[upload_mid]="#C5C4DD"
theme[upload_end]="#FFB68A"
