#!/usr/bin/env python3
"""
change-wallpaper: Integrated Material You Theme & Wallpaper Manager
Synchronizes Wallpaper, Kitty, Sway, Waybar, Firefox, Chromium, Wofi, Swaylock,
SwayNC, GTK/Thunar, Neovim, Phylax, btop, ncmpcpp, and CAVA with dynamic Material 3 colors.

Modularized architecture importing from ~/.config/change-wallpaper/
Powered by materialyoucolor (https://github.com/T-Dynamos/materialyoucolor-python).
"""

import argparse
import shutil
import subprocess
import sys
import time
from pathlib import Path
from PIL import Image

# Ensure ~/.config/change-wallpaper is on the Python module search path
CONFIG_DIR = Path.home() / ".config" / "change-wallpaper"
if str(CONFIG_DIR) not in sys.path:
    sys.path.insert(0, str(CONFIG_DIR))

from config import WALLPAPER_TARGET
from palette import SCHEMES, extract_palette
from modules import (
    update_kitty,
    update_sway,
    update_waybar,
    update_memento_mori,
    restart_waybars,
    update_firefox,
    update_chromium,
    update_wofi,
    update_swaylock,
    update_swaync,
    update_gtk,
    update_neovim,
    update_phylax,
    update_btop,
    update_ncmpcpp,
    update_cava,
)

MODULE_DISPATCH = {
    "kitty": update_kitty,
    "sway": update_sway,
    "waybar": lambda pal: (update_waybar(pal), update_memento_mori(pal), restart_waybars()),
    "firefox": update_firefox,
    "chromium": update_chromium,
    "wofi": update_wofi,
    "swaylock": update_swaylock,
    "swaync": update_swaync,
    "gtk": update_gtk,
    "neovim": update_neovim,
    "phylax": update_phylax,
    "btop": update_btop,
    "ncmpcpp": update_ncmpcpp,
    "cava": update_cava,
}


def apply_wallpaper(image_path=None, scheme="expressive", is_dark=True, modules=None):
    if image_path:
        img_p = Path(image_path).expanduser().resolve()
        if not img_p.is_file():
            print(f"Error: Wallpaper image '{image_path}' not found.", file=sys.stderr)
            sys.exit(1)
        try:
            with Image.open(img_p) as test_img:
                test_img.verify()
        except Exception as e:
            print(f"Error: File '{image_path}' is not a valid image: {e}", file=sys.stderr)
            sys.exit(1)

        WALLPAPER_TARGET.parent.mkdir(parents=True, exist_ok=True)
        if img_p.resolve() != WALLPAPER_TARGET.resolve():
            shutil.copy2(img_p, WALLPAPER_TARGET)
            print(f"Wallpaper updated: {img_p} -> {WALLPAPER_TARGET}")
        else:
            print(f"Wallpaper already at target: {WALLPAPER_TARGET}")
    else:
        if not WALLPAPER_TARGET.is_file():
            print(f"Error: No wallpaper specified and {WALLPAPER_TARGET} does not exist.", file=sys.stderr)
            sys.exit(1)
        print(f"Refreshing theme using active wallpaper: {WALLPAPER_TARGET}")

    print("Generating Material You palette...")
    pal = extract_palette(WALLPAPER_TARGET, is_dark=is_dark, scheme_name=scheme)

    targets = [m.lower() for m in modules] if modules else list(MODULE_DISPATCH.keys())

    for mod_name in targets:
        if mod_name in MODULE_DISPATCH:
            print(f"Updating {mod_name}...")
            MODULE_DISPATCH[mod_name](pal)
        else:
            print(f"[Warning] Unknown module: {mod_name}", file=sys.stderr)

    print("\nMaterial You Theme successfully applied!")
    print(f"  Seed:       {pal['seed']}")
    print(f"  Surface:    {pal['surface']}")
    print(f"  Primary:    {pal['primary']}")
    print(f"  Container:  {pal['surface_container']}")
    print(f"  OnSurface:  {pal['on_surface']}")

    try:
        updated_desc = ", ".join(t.capitalize() for t in targets)
        subprocess.run(
            ["notify-send", "-a", "Material You", "Theme Updated", f"Applied across {updated_desc}."],
            stderr=subprocess.DEVNULL
        )
    except Exception:
        pass


def watch_wallpaper(scheme="expressive", is_dark=True):
    print(f"Watching {WALLPAPER_TARGET} for changes... (Press Ctrl+C to stop)")
    last_mtime = WALLPAPER_TARGET.stat().st_mtime if WALLPAPER_TARGET.exists() else 0
    try:
        while True:
            time.sleep(2)
            if WALLPAPER_TARGET.exists():
                curr_mtime = WALLPAPER_TARGET.stat().st_mtime
                if curr_mtime != last_mtime:
                    last_mtime = curr_mtime
                    print(f"\n[Change Detected] Re-generating themes from {WALLPAPER_TARGET}...")
                    apply_wallpaper(scheme=scheme, is_dark=is_dark)
    except KeyboardInterrupt:
        print("\nWatcher stopped.")


def main():
    parser = argparse.ArgumentParser(
        description="Synchronize Wallpaper, Kitty, Sway, Waybar, Firefox, Chromium, Wofi, Swaylock, SwayNC, GTK, Neovim, Phylax, btop, ncmpcpp, and CAVA with Material You colors."
    )
    parser.add_argument("image", nargs="?", help="Path to new wallpaper image (optional)")
    parser.add_argument("--scheme", choices=list(SCHEMES.keys()), default="expressive", help="Material dynamic scheme (default: expressive)")
    parser.add_argument("--light", action="store_true", help="Generate light mode instead of dark mode")
    parser.add_argument("--watch", action="store_true", help="Run watcher to automatically update themes when ~/.config/wallpaper changes")
    parser.add_argument("--module", "-m", action="append", help="Apply theme only to specific module(s) (e.g. --module cava --module ncmpcpp)")

    args = parser.parse_args()

    if args.watch:
        watch_wallpaper(scheme=args.scheme, is_dark=not args.light)
    else:
        apply_wallpaper(args.image, scheme=args.scheme, is_dark=not args.light, modules=args.module)


if __name__ == "__main__":
    main()
