#!/usr/bin/env bash
# Global Crush configuration (~/.config/crush/crushrc)
# Managed via chezmoi

# Local Ollama provider with model auto-discovery
provider add ollama \
  --name Ollama \
  --type ollama \
  --base-url "http://localhost:11434/v1/" \
  --discover-models true

# Register Qwen 3.6 35B-A3B explicitly (32K context to match OLLAMA_CONTEXT_LENGTH=32768)
model add ollama/qwen3.6:35b \
  --name "Qwen 3.6 35B-A3B" \
  --context-window 32768 \
  --default-max-tokens 16384 \
  --thinking toggleable \
  --supports-images true

# Register Qwen 3.5 9B (fits 100% on Radeon 780M Vulkan GPU, fast + vision + thinking)
model add ollama/qwen3.5:9b \
  --name "Qwen 3.5 9B" \
  --context-window 32768 \
  --default-max-tokens 8192 \
  --thinking toggleable \
  --supports-images true

model large ollama/qwen3.6:35b --think
model small ollama/qwen3.5:9b

# Give local Ollama prefill enough breathing room (default is 60s)
option request-timeout 300

# Full tool permissions (auto-approve all built-in tools without prompting)
permissions allow \
  agent \
  agent_dispatch \
  agent_send \
  agent_status \
  agent_stop \
  bash \
  crush_info \
  crush_logs \
  job_output \
  job_kill \
  download \
  edit \
  multiedit \
  lsp_diagnostics \
  lsp_references \
  lsp_restart \
  lsp_symbols \
  lsp_definition \
  lsp_call_hierarchy \
  lsp_rename \
  lsp_replace_symbol \
  fetch \
  agentic_fetch \
  glob \
  grep \
  ls \
  question \
  sourcegraph \
  todos \
  view \
  write \
  list_mcp_resources \
  read_mcp_resource

# Unblock default bash command restrictions for full local system access
permissions unblock \
  alias aria2c axel chrome curl curlie firefox http-prompt httpie links lynx nc \
  safari scp ssh telnet w3m wget xh \
  doas su sudo \
  env eval nohup xargs \
  apk apt apt-cache apt-get dnf dpkg emerge home-manager makepkg opkg pacman \
  paru pkg pkg_add pkg_delete portage rpm yay yum zypper \
  at batch chkconfig crontab fdisk mkfs mount parted service systemctl umount \
  firewall-cmd ifconfig ip iptables netstat pfctl route ufw
