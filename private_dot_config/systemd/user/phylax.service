[Unit]
Description=Phylax Polkit Authentication Agent
Documentation=https://github.com/jakeb-grant/phylax
PartOf=graphical-session.target
After=graphical-session.target

[Service]
Type=simple
ExecStart=/bin/sh -c 'XDG_SESSION_ID="$${XDG_SESSION_ID:-$$(loginctl session-status 2>/dev/null | head -n 1 | awk "{print \$$1}")}" exec %h/.local/bin/phylax'
Restart=on-failure
RestartSec=1
Slice=session.slice

[Install]
WantedBy=graphical-session.target
