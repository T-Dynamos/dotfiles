def update_swaylock(pal):
    SWAYLOCK_DIR.mkdir(parents=True, exist_ok=True)
    cfg_file = SWAYLOCK_DIR / "config"
    def hx(c):
        return c.lstrip("#")

    content = f"""# Swaylock Material 3 Dark Theme
# Auto-generated by change-wallpaper using materialyoucolor

image={WALLPAPER_TARGET}
scaling=fill
color={hx(pal["surface"])}

font=JetBrainsMono Nerd Font
font-size=16

indicator-radius=110
indicator-thickness=9
indicator-idle-visible

# Inside indicator circle (semi-transparent surface)
inside-color={hx(pal["surface"])}D9
inside-clear-color={hx(pal["surface_container_high"])}D9
inside-ver-color={hx(pal["surface_container"])}D9
inside-wrong-color={hx(pal["error_container"])}D9

# Outer ring
ring-color={hx(pal["outline_variant"])}
ring-clear-color={hx(pal["secondary"])}
ring-ver-color={hx(pal["primary"])}
ring-wrong-color={hx(pal["error"])}

# Keypress / backspace highlight
key-hl-color={hx(pal["primary"])}
bs-hl-color={hx(pal["error"])}

# Text inside ring
text-color={hx(pal["on_surface"])}
text-clear-color={hx(pal["on_surface"])}
text-ver-color={hx(pal["primary"])}
text-wrong-color={hx(pal["error"])}

line-uses-inside
separator-color=00000000
grace=0
ignore-empty-password
show-failed-attempts
"""
    cfg_file.write_text(content)


def update_swaync(pal):
    SWAYNC_DIR.mkdir(parents=True, exist_ok=True)
    cfg_file = SWAYNC_DIR / "config.json"
    if not cfg_file.exists():
        src_cfg = Path("/etc/xdg/swaync/config.json")
        if src_cfg.is_file():
            shutil.copy2(src_cfg, cfg_file)

    style_css = SWAYNC_DIR / "style.css"
    r_cc, g_cc, b_cc = hex_to_rgb(pal["surface"])
    r_cont, g_cont, b_cont = hex_to_rgb(pal["surface_container"])

    content = f"""/* SwayNC Material Design 3 Dark Theme */
/* Auto-generated by change-wallpaper using materialyoucolor */

* {{
  font-family: JetBrainsMono Nerd Font, Roboto, sans-serif;
}}

notificationwindow, blankwindow {{
  background: transparent;
