# Swaylock Material 3 Dark Theme
# Auto-generated by change-wallpaper using materialyoucolor

image=/home/tdynamos/.config/wallpaper
scaling=fill
color=190A02

font=JetBrainsMono Nerd Font
font-size=16

indicator-radius=110
indicator-thickness=9
indicator-idle-visible

# Inside indicator circle (semi-transparent surface)
inside-color=190A02D9
inside-clear-color=321A05D9
inside-ver-color=291404D9
inside-wrong-color=881F05D9

# Outer ring
ring-color=624025
ring-clear-color=B8C8DA
ring-ver-color=FFBA97
ring-wrong-color=FE7453

# Keypress / backspace highlight
key-hl-color=FFBA97
bs-hl-color=FE7453

# Text inside ring
text-color=FFDFCB
text-clear-color=FFDFCB
text-ver-color=FFBA97
text-wrong-color=FE7453

line-uses-inside
separator-color=00000000
grace=0
ignore-empty-password
show-failed-attempts
