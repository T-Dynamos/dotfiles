#!/usr/bin/env python3
"""
change-wallpaper: Integrated Material You Theme & Wallpaper Manager
Synchronizes Wallpaper, Kitty, Sway, Waybar, and Firefox with dynamic Material 3 colors.
Powered by materialyoucolor (https://github.com/T-Dynamos/materialyoucolor-python).
"""

import argparse
import datetime
import json
import os
from pathlib import Path
import shutil
import subprocess
import sys
import time

from PIL import Image

from materialyoucolor.quantize import ImageQuantizeCelebi
from materialyoucolor.score.score import Score
from materialyoucolor.hct import Hct
from materialyoucolor.scheme.scheme_expressive import SchemeExpressive
from materialyoucolor.scheme.scheme_tonal_spot import SchemeTonalSpot
from materialyoucolor.scheme.scheme_vibrant import SchemeVibrant
from materialyoucolor.scheme.scheme_fruit_salad import SchemeFruitSalad
from materialyoucolor.scheme.scheme_rainbow import SchemeRainbow
from materialyoucolor.dynamiccolor.material_dynamic_colors import MaterialDynamicColors
from materialyoucolor.blend.blend import Blend
from materialyoucolor.utils.color_utils import hex_from_argb

SCHEMES = {
    "expressive": SchemeExpressive,
    "tonal-spot": SchemeTonalSpot,
    "vibrant": SchemeVibrant,
    "fruit-salad": SchemeFruitSalad,
    "rainbow": SchemeRainbow,
}

WALLPAPER_TARGET = Path.home() / ".config" / "wallpaper"
KITTY_DIR = Path.home() / ".config" / "kitty"
SWAY_DIR = Path.home() / ".config" / "sway"
WAYBAR_DIR = Path.home() / ".config" / "waybar"
MOZILLA_DIR = Path.home() / ".mozilla" / "firefox"
WOFI_DIR = Path.home() / ".config" / "wofi"
SWAYLOCK_DIR = Path.home() / ".config" / "swaylock"
SWAYNC_DIR = Path.home() / ".config" / "swaync"
GTK3_DIR = Path.home() / ".config" / "gtk-3.0"
GTK4_DIR = Path.home() / ".config" / "gtk-4.0"
NVIM_DIR = Path.home() / ".config" / "nvim"
PHYLAX_DIR = Path.home() / ".config" / "phylax"


def hex_to_rgb(hx):
    hx = hx.lstrip("#")
    return int(hx[0:2], 16), int(hx[2:4], 16), int(hx[4:6], 16)


def extract_palette(image_path, is_dark=True, scheme_name="expressive"):
    seed = None
    path_str = str(image_path)
    if Path(image_path).is_file():
        try:
            colors = ImageQuantizeCelebi(path_str, 5, 128)
            ranked = Score.score(colors)
            if ranked:
                seed = ranked[0]
        except Exception as e:
            print(f"[Warning] Failed to quantize image with C++ celebi: {e}", file=sys.stderr)

    if seed is None:
        seed = 0xFF6750A4  # Default Material purple seed

    scheme_cls = SCHEMES.get(scheme_name.lower(), SchemeExpressive)
    scheme = scheme_cls(Hct.from_int(seed), is_dark, 0.0)
    mdc = MaterialDynamicColors()

    def get_c(name):
        return getattr(mdc, name).get_hex(scheme)[:7]

    def harm_tone(color_int, tone):
        h = Hct.from_int(Blend.harmonize(color_int, seed))
        h.tone = tone
        return hex_from_argb(h.to_int())[:7]

    return {
        "seed": hex_from_argb(seed)[:7],
        "surface": get_c("surface"),
        "surface_container": get_c("surfaceContainer"),
        "surface_container_high": get_c("surfaceContainerHigh"),
        "surface_container_lowest": get_c("surfaceContainerLowest"),
        "on_surface": get_c("onSurface"),
        "on_surface_variant": get_c("onSurfaceVariant"),
        "outline": get_c("outline"),
        "outline_variant": get_c("outlineVariant"),
        "primary": get_c("primary"),
        "on_primary": get_c("onPrimary"),
        "primary_container": get_c("primaryContainer"),
        "on_primary_container": get_c("onPrimaryContainer"),
        "secondary": get_c("secondary"),
        "on_secondary": get_c("onSecondary"),
        "secondary_container": get_c("secondaryContainer"),
        "on_secondary_container": get_c("onSecondaryContainer"),
        "tertiary": get_c("tertiary"),
        "on_tertiary": get_c("onTertiary"),
        "tertiary_container": get_c("tertiaryContainer"),
        "on_tertiary_container": get_c("onTertiaryContainer"),
        "error": get_c("error"),
        "on_error": get_c("onError"),
        "error_container": get_c("errorContainer"),
        "on_error_container": get_c("onErrorContainer"),
        "green": harm_tone(0xFF4CAF50, 80),
        "green_bright": harm_tone(0xFF4CAF50, 90),
        "green_dark": harm_tone(0xFF4CAF50, 20),
        "yellow": harm_tone(0xFFFFEB3B, 80),
        "yellow_bright": harm_tone(0xFFFFEB3B, 90),
        "yellow_dark": harm_tone(0xFFFFEB3B, 20),
        "teal": harm_tone(0xFF00BCD4, 80),
        "teal_bright": harm_tone(0xFF00BCD4, 90),
        "teal_dark": harm_tone(0xFF00BCD4, 20),
        "purple": harm_tone(0xFFAB47BC, 80),
        "purple_bright": harm_tone(0xFFAB47BC, 90),
        "purple_dark": harm_tone(0xFFAB47BC, 20),
        "peach": harm_tone(0xFFFF8A65, 80),
        "peach_bright": harm_tone(0xFFFF8A65, 90),
        "peach_dark": harm_tone(0xFFFF8A65, 20),
    }


def update_kitty(pal):
    colors_conf = KITTY_DIR / "colors.conf"
    kitty_conf = KITTY_DIR / "kitty.conf"

    content = f"""# Material You Dark Theme for Kitty
# Auto-generated by change-wallpaper using materialyoucolor

background            {pal["surface"]}
foreground            {pal["on_surface"]}

selection_background  {pal["secondary_container"]}
selection_foreground  {pal["on_secondary_container"]}

url_color             {pal["tertiary"]}

cursor                {pal["primary"]}
cursor_text_color     {pal["surface"]}

# Tabs
active_tab_background   {pal["primary"]}
active_tab_foreground   {pal["surface"]}
inactive_tab_background {pal["surface_container"]}
inactive_tab_foreground {pal["on_surface_variant"]}
tab_bar_background      {pal["surface"]}

# Window Borders
active_border_color     {pal["primary"]}
inactive_border_color   {pal["surface_container"]}
bell_border_color       {pal["error"]}

# ANSI 16 Colors
color0  {pal["surface_container"]}
color1  {pal["error"]}
color2  {pal["green"]}
color3  {pal["yellow"]}
color4  {pal["tertiary"]}
color5  {pal["purple"]}
color6  {pal["teal"]}
color7  {pal["on_surface_variant"]}

color8  {pal["outline"]}
color9  {pal["error_container"]}
color10 {pal["green_bright"]}
color11 {pal["yellow_bright"]}
color12 {pal["tertiary_container"]}
color13 {pal["purple_bright"]}
color14 {pal["teal_bright"]}
color15 {pal["on_surface"]}
"""
    colors_conf.write_text(content)

    if kitty_conf.is_file():
        kc_text = kitty_conf.read_text()
        if "include colors.conf" not in kc_text:
            lines = []
            for line in kc_text.splitlines():
                if any(line.strip().startswith(prefix) for prefix in [
                    "background ", "active_tab_background ", "inactive_tab_background "
                ]):
                    continue
                lines.append(line)
            lines.append("include colors.conf")
            kitty_conf.write_text("\n".join(lines) + "\n")

    subprocess.run(["pkill", "-SIGUSR1", "kitty"], stderr=subprocess.DEVNULL)


def update_sway(pal):
    theme_file = SWAY_DIR / "theme"
    sway_conf = SWAY_DIR / "config"

    content = f"""# Material You Theme for Sway
# Auto-generated by change-wallpaper using materialyoucolor

output * bg ~/.config/wallpaper fill

client.focused          {pal["primary"]} {pal["surface_container"]} {pal["on_surface"]} {pal["secondary"]} {pal["primary"]}
client.focused_inactive {pal["surface_container_high"]} {pal["surface"]} {pal["on_surface_variant"]} {pal["surface_container"]} {pal["surface_container_high"]}
client.unfocused        {pal["surface_container"]} {pal["surface"]} {pal["on_surface_variant"]} {pal["surface_container"]} {pal["surface_container"]}
client.urgent           {pal["error"]} {pal["error"]} {pal["on_error"]} {pal["error"]} {pal["error"]}
"""
    theme_file.write_text(content)

    if sway_conf.is_file():
        sc_text = sway_conf.read_text()
        if "include theme" not in sc_text:
            new_lines = []
            for line in sc_text.splitlines():
                if line.strip().startswith("client.focused ") or line.strip().startswith("output * bg"):
                    continue
                new_lines.append(line)
            sc_text_updated = "\n".join(new_lines)
            if "smart_borders" in sc_text_updated:
                sc_text_updated = sc_text_updated.replace("smart_borders", "include theme\nsmart_borders", 1)
            else:
                sc_text_updated = "include theme\n" + sc_text_updated
            sway_conf.write_text(sc_text_updated)

    # Live apply to sway
    subprocess.run(["swaymsg", f"client.focused {pal['primary']} {pal['surface_container']} {pal['on_surface']} {pal['secondary']} {pal['primary']}"], stderr=subprocess.DEVNULL)
    subprocess.run(["swaymsg", f"client.focused_inactive {pal['surface_container_high']} {pal['surface']} {pal['on_surface_variant']} {pal['surface_container']} {pal['surface_container_high']}"], stderr=subprocess.DEVNULL)
    subprocess.run(["swaymsg", f"client.unfocused {pal['surface_container']} {pal['surface']} {pal['on_surface_variant']} {pal['surface_container']} {pal['surface_container']}"], stderr=subprocess.DEVNULL)
    subprocess.run(["swaymsg", f"client.urgent {pal['error']} {pal['error']} {pal['on_error']} {pal['error']} {pal['error']}"], stderr=subprocess.DEVNULL)
    subprocess.run(["swaymsg", "output * bg ~/.config/wallpaper fill"], stderr=subprocess.DEVNULL)


